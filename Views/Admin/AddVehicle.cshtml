@model VehicleManagement.Models.Vehicle

@{
    ViewData["Title"] = "Admin - Add New Vehicle";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-white text-shadow-sm">
            <i class="bi bi-car-front-fill me-3"></i> Admin: Add New Vehicle
        </h2>
        <p class="lead text-light opacity-75">Fill in the details to register a new vehicle.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-4 animate-fade-in">
                <div class="card-body">
                    <form asp-controller="Admin" asp-action="AddVehicle" method="post">
                        @* ASP.NET Core automatically includes an anti-forgery token for POST forms. *@
                        @* <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div> *@

                        <div class="mb-3">
                            <label asp-for="RegistrationNumber" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="RegistrationNumber" class="form-control form-control-lg rounded-pill-input" />
                            <span asp-validation-for="RegistrationNumber" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Make" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="Make" class="form-control form-control-lg rounded-pill-input" />
                            <span asp-validation-for="Make" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="Model" class="form-control form-control-lg rounded-pill-input" />
                            <span asp-validation-for="Model" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="Type" class="form-control form-control-lg rounded-pill-input" />
                            <span asp-validation-for="Type" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold text-dark"></label>
                            <select asp-for="Status" class="form-select form-select-lg rounded-pill-input">
                                <option value="Active">Active</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastMaintenanceDate" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="LastMaintenanceDate" type="date" class="form-control form-control-lg rounded-pill-input" />
                            <span asp-validation-for="LastMaintenanceDate" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="UserId" class="form-label fw-semibold text-dark">Assign to User</label>
                            <select asp-for="UserId" class="form-select form-select-lg rounded-pill-input">
                                <option value="">-- Select User --</option> @* Optional: Add a default empty option *@
                                @if (ViewBag.Users != null)
                                {
                                    @foreach (var user in ViewBag.Users)
                                    {
                                        <option value="@user.Id">@user.UserName</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="UserId" class="text-danger mt-1 d-block"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-custom btn-primary-custom">
                                <i class="bi bi-save-fill me-2"></i> Add Vehicle
                            </button>
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-custom btn-outline-secondary-custom mt-3">
                                <i class="bi bi-arrow-left-circle-fill me-2"></i> Back to Admin Dashboard
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

@section Styles {
    <style>
        /* Reusing global styles, ensure these match your site's overall look */
        body {
            background: linear-gradient(to right, #4CAF50, #8BC34A); /* Green gradient background */
        }

        .text-shadow-sm {
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .card {
            background-color: rgba(255, 255, 255, 0.95);
        }

        .rounded-4 {
            border-radius: .75rem !important;
        }

        .btn-custom {
            padding: .6rem 1.2rem;
            font-size: 1rem;
            border-radius: .5rem;
            transition: all 0.3s ease;
        }

        .btn-primary-custom {
            background-color: #007bff; /* Primary blue */
            border-color: #007bff;
            color: white;
        }

            .btn-primary-custom:hover {
                background-color: #0056b3;
                border-color: #0056b3;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            }

        .btn-outline-secondary-custom {
            border-color: #6c757d;
            color: #6c757d;
        }

            .btn-outline-secondary-custom:hover {
                background-color: #6c757d;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            }

        .form-control-lg {
            padding: .5rem 1rem;
            font-size: 1.125rem;
            line-height: 1.5;
            border-radius: .3rem;
        }

        .rounded-pill-input {
            border-radius: 25px; /* Adjust as needed for pill shape */
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .form-label {
            margin-bottom: .25rem;
        }

        .animate-fade-in {
            animation: fadeIn 0.8s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}