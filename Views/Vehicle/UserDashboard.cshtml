@model IEnumerable<VehicleManagement.Models.Vehicle>

@{
    ViewData["Title"] = "My Vehicles";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-white text-shadow-sm">
            <i class="bi bi-car-fill me-3"></i> Your Registered Vehicles
        </h2>
        <p class="lead text-light opacity-75">
            View and manage your personal fleet of vehicles.
        </p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <!-- Removed "Register New Vehicle" button as per the requirement that users can only view -->
        <!-- Adding a Back to Home button for user convenience -->
        <a asp-controller="Home" asp-action="Index" class="btn btn-custom btn-outline-secondary-custom">
            <i class="bi bi-house-door-fill me-2"></i> Back to Home
        </a>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-custom btn-outline-danger-custom">
            <i class="bi bi-box-arrow-right me-2"></i> Logout
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center custom-alert-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show text-center custom-alert-danger mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-lg border-0 rounded-4 animate-fade-in">
        <div class="card-body p-4">
            <h4 class="card-title mb-4 text-dark">Your Fleet Overview</h4>
            @if (!Model.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="lead">You do not have any vehicles assigned.</p>
                    <p>Please contact your administrator to assign vehicles to your account.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle rounded-3 overflow-hidden">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th scope="col">Registration Number</th>
                                <th scope="col">Make</th>
                                <th scope="col">Model</th>
                                <th scope="col">Type</th>
                                <th scope="col">Status</th>
                                <th scope="col">Last Maintenance Date</th>
                                <th scope="col" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="table-row-clickable" data-vehicle-id="@item.Id">
                                    <td>@item.RegistrationNumber</td>
                                    <td>@item.Make</td>
                                    <td>@item.Model</td>
                                    <td>@item.Type</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 @(item.Status == "Active" ? "bg-success" : (item.Status == "Maintenance" ? "bg-warning text-dark" : "bg-danger"))">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@(item.LastMaintenanceDate?.ToShortDateString() ?? "N/A")</td>
                                    <td class="text-center">
                                        <!-- Users can only see details, no Edit/Delete/Add Maintenance -->
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info-custom" title="Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- Bootstrap Icons (if not already included in _Layout) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
        // Optional: Make entire row clickable for details (if desired)
        document.querySelectorAll('.table-row-clickable').forEach(row => {
            row.addEventListener('click', function (event) {
                // Prevent navigating if an action button was clicked
                if (event.target.closest('a')) {
                    return;
                }
                const vehicleId = this.dataset.vehicleId;
                if (vehicleId) {
                    window.location.href = `/Vehicle/Details/${vehicleId}`;
                }
            });
        });
    </script>
}

@section Styles {
    <style>
        /* Reusing global styles from _Layout and Admin Index */
        .text-shadow-sm {
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .custom-alert-success {
            background-color: #d4edda;
            color: #155724;
            border-color: #c3e6cb;
            border-radius: .5rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            font-weight: 500;
        }

            .custom-alert-success .btn-close {
                color: #155724;
            }

        /* Custom alert for errors (copied from Login/Register) */
        .custom-alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            border-color: #f5c6cb;
            border-radius: .5rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            font-weight: 500;
        }

            .custom-alert-danger .btn-close {
                color: #721c24;
            }

        .card {
            background-color: rgba(255, 255, 255, 0.95); /* Slightly transparent white card background */
        }

        .table-hover tbody tr:hover {
            background-color: #e9ecef; /* Lighter hover background for table rows */
            cursor: pointer;
            transition: background-color 0.2s ease-in-out;
        }

        .table-bordered {
            border-color: #dee2e6;
        }

        .table thead th {
            border-bottom: 2px solid #343a40; /* Stronger border for table header */
        }

        /* Status badge specific colors */
        .badge.bg-success {
            background-color: #28a745 !important;
        }

        .badge.bg-warning {
            background-color: #ffc107 !important;
        }

        .badge.bg-danger {
            background-color: #dc3545 !important;
        }

        /* Ensure rounded corners on table */
        .rounded-3 {
            border-radius: .5rem !important;
        }

        .rounded-4 {
            border-radius: .75rem !important;
        }

        .overflow-hidden {
            overflow: hidden; /* Ensures rounded corners apply to table content */
        }

        /* Action buttons in table */
        .table td .btn-sm {
            padding: .25rem .5rem;
            font-size: .875rem;
            line-height: 1.5;
            border-radius: .2rem;
        }

        /* Custom button styles (should be consistent with _Layout.cshtml) */
        .btn-custom {
            border-radius: 50px;
            padding: 12px 30px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
            border: none;
        }

            .btn-custom:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
            }

        .btn-primary-custom {
            background: linear-gradient(45deg, #007bff, #0056b3);
            color: white;
        }

            .btn-primary-custom:hover {
                background: linear-gradient(45deg, #0056b3, #007bff);
            }

        .btn-success-custom {
            background: linear-gradient(45deg, #28a745, #1e7e34);
            color: white;
        }

            .btn-success-custom:hover {
                background: linear-gradient(45deg, #1e7e34, #28a745);
            }

        .btn-info-custom {
            background: linear-gradient(45deg, #17a2b8, #117a8b);
            color: white;
        }

            .btn-info-custom:hover {
                background: linear-gradient(45deg, #117a8b, #17a2b8);
            }

        .btn-warning-custom {
            background: linear-gradient(45deg, #ffc107, #d39e00);
            color: #333;
        }

            .btn-warning-custom:hover {
                background: linear-gradient(45deg, #d39e00, #ffc107);
            }

        .btn-outline-danger-custom {
            border: 2px solid #dc3545;
            color: #dc3545;
            background-color: transparent;
        }

            .btn-outline-danger-custom:hover {
                background-color: #dc3545;
                color: white;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            }

        .btn-danger-custom {
            background: linear-gradient(45deg, #dc3545, #b02a37);
            color: white;
        }

            .btn-danger-custom:hover {
                background: linear-gradient(45deg, #b02a37, #dc3545);
            }

        .btn-outline-secondary-custom {
            border: 2px solid #6c757d; /* Gray border */
            color: #6c757d; /* Gray text */
            background-color: transparent;
        }

            .btn-outline-secondary-custom:hover {
                background-color: #6c757d; /* Solid gray background on hover */
                color: white;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            }

        /* Animation for form */
        .animate-fade-in {
            animation: fadeIn 0.8s ease-out;
        }

        @@keyframes fadeIn { /* Fixed: Escaped with @@keyframes */
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}